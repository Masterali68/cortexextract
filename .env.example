# --- CortexExtract environment (copy to .env) ---

# FastAPI
APP_VERSION=0.5.0

# CORS
DEV_ORIGINS=http://localhost:3000

# BYOK — never store real keys in .env; these are defaults only.
# Keys are provided per-request via X-Groq-Key / X-OpenAI-Key headers.

# Local LLM (Ollama)
OLLAMA_ENDPOINT=http://localhost:11434

# Supabase / PostgreSQL (pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Redis (cache + rate limiting)
REDIS_URL=redis://localhost:6379/0

# Stealth scraper proxy rotation (comma-separated, optional)
# PROXY_URLS=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
PROXY_URLS=

# Extraction cache TTL (seconds)
EXTRACT_CACHE_TTL=300